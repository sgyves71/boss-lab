{
  "name": "boss-lab",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test src/combat.test.ts src/replay.test.ts src/practice.test.ts src/saved-run.test.ts",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "demo": "node src/demo.ts",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test",
    "verify": "npm run check && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "typescript": "5.9",
    "vite": "^8.3.8"
  }
}
